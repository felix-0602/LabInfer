     "rung_id": "L3-formula",
     "level": 3,
     "title": "浓度与总碱度怎么算",
     "concept": "相对平均偏差的含义与代入公式计算 c、w",
     "anchor": {
      "type": "fit"
     },
     "trigger": null,
     "source": "实验教材 实验 3 数据处理"
    },
    {
     "rung_id": "L4-indicator",
     "level": 4,
     "title": "为什么用甲基橙",
     "concept": "Na₂CO₃ 有两个化学计量点（约 pH 8.3 与 3.9），第二个落在甲基橙变色区内",
     "anchor": {
      "type": "comparison",
      "target": "titration_curve"
     },
     "trigger": null,
     "source": "实验教材 实验目的 3；分析化学教材 酸碱滴定章"
    },
    {
     "rung_id": "L4-co2",
     "level": 4,
     "title": "为什么近终点要防 CO₂",
     "concept": "溶解的 CO₂ 形成缓冲，突跃变缓，终点提前",
     "anchor": {
      "type": "comparison",
      "target": "titration_curve"
     },
     "trigger": null,
     "source": "分析化学教材；GB/T 601-2016 HCl 标定条（煮沸步骤，待核）"
    },
    {
     "rung_id": "L5-error-type",
     "level": 5,
     "title": "误差分系统与随机",
     "concept": "系统误差让三份同向偏移、拉动平均值；随机误差拉大离散。基准物吸水 1% 是系统误差（思考题 2）",
     "anchor": {
      "type": "comparison",
      "target": "vs_limit[0]"
     },
     "trigger": null,
     "source": "实验教材 思考题 2"
    },
    {
     "rung_id": "L5-mass-range",
     "level": 5,
     "title": "为什么称样量 0.15～0.20 g、滴定体积 20 mL 以上",
     "concept": "天平两次称量 ±0.0002 g、滴定管两次读数 ±0.02 mL，各自控制在约 0.1% 以内",
     "anchor": {
      "type": "fit"
     },
     "trigger": null,
     "source": "分析化学教材 误差与有效数字章"
    },
    {
     "rung_id": "L6-budget",
     "level": 6,
     "title": "测量不确定度",
     "concept": "把称量、读数、定容、移液的贡献合成扩展不确定度，判断偏差是否超出仪器所能解释的范围",
     "anchor": {
      "type": "comparison",
      "target": "error_budget"
     },
     "trigger": null,
     "source": "JJF 1059.1-2012（GUM 国内版）"
    },
    {
     "rung_id": "L6-endpoint-error",
     "level": 6,
     "title": "指示剂终点误差可以定量算",
     "concept": "林邦误差公式；本实验未煮沸时甲基橙在计量点前约 0.15 mL 开始变色，煮沸后移到计量点后约 0.02 mL",
     "anchor": {
      "type": "comparison",
      "target": "titration_curve"
     },
     "trigger": null,
     "source": "分析化学教材 终点误差节"
    },
